# Linux agent container for local dev (simulates a VPS agent on Mac).
FROM golang:1.25-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/trinityproxy . \
	&& CGO_ENABLED=0 GOOS=linux go build -o /out/installer ./cmd/installer

FROM debian:bookworm-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends dante-server ca-certificates \
	&& rm -f /etc/danted.conf \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/trinityproxy /out/installer ./build/
COPY docker/agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV TRINITY_ROOT=/app

ENTRYPOINT ["/entrypoint.sh"]
