// Allow trinityproxy dashboard to start the SSL provisioning oneshot (no sudo; works with NoNewPrivileges).
polkit.addRule(function(action, subject) {
    if (subject.user == "trinityproxy" &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "trinityproxy-ssl-provision.service" &&
        action.lookup("verb") == "start") {
        return polkit.Result.YES;
    }
});
